{
  "manifest_version": 3,
  "name": "BOJ Performance",
  "version": "1.1.0",
  "description": "백준 온라인 저지(BOJ) 채점 현황에 내 코드의 성능(실행 시간, 메모리) 위치를 그래프로 시각화합니다.",
  "permissions": ["declarativeNetRequest"],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "host_permissions": ["https://acmicpc.net/*", "https://www.acmicpc.net/*"],
  "content_scripts": [
    {
      "matches": ["https://acmicpc.net/status*", "https://www.acmicpc.net/status*"],
      "js": [
        "js/libs/chart.js",
        "js/utils.js",
        "js/api.js",
        "js/data.js",
        "js/ui.js",
        "js/graph.js",
        "js/main.js"
      ],
      "css": [
        "css/layout.css",
        "css/card.css",
        "css/tooltip.css",
        "css/theme.css"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{e8f7a9c2-4b1d-4f3e-8a5c-9b2d1e0f3a4c}",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
